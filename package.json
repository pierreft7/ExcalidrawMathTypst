{
  "name": "excalimath",
  "private": true,
  "version": "2.0.0",
  "description": "A Typst-native math whiteboard companion for Excalidraw — equations, function graphs, and STEM shape libraries.",
  "license": "MIT",
  "author": "Tamer — ITWorx EdTech",
  "repository": {
    "type": "git",
    "url": "https://github.com/tamerUAE/excalimath.git"
  },
  "keywords": [
    "excalidraw",
    "math",
    "typst",
    "whiteboard",
    "education",
    "stem"
  ],
  "workspaces": [
    "packages/*",
    "apps/demo",
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/demo",
    "build": "npm run build --workspace=packages/core && npm run build --workspace=apps/demo",
    "build:core": "npm run build --workspace=packages/core",
    "typecheck": "npm run typecheck --workspace=packages/core && tsc --noEmit -p apps/demo/tsconfig.json",
    "test": "npm run test --workspace=packages/core"
  },
  "engines": {
    "node": ">=20"
  }
}
